# Mountrr environment variables
# Copy to .env for local development (never commit .env)

TZ=America/Chicago
PUID=1000
PGID=1000

# Scan settings (seed DB on first boot only — change via UI after that)
SCAN_INTERVAL=720
DRY_RUN=false
LOG_LEVEL=INFO

# Arr integration — v1.1 (optional, seeds DB on first boot)
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
